{
  "expo": {
    "name": "TaGarantido",
    "slug": "ta-garantido",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "tagarantido",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.tagarantido.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F5F5EE"
      }
    },
    "plugins": [
      "expo-document-picker",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ]
  }
}
